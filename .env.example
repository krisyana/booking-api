ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://localhost/booking_api

# In production both secrets must be changed; the app refuses to start with the defaults.
WEBHOOK_SECRET=change-me
TOKEN_SECRET=change-me-too

HOLD_MINUTES=15

# Placeholders: only "fake" and "console" are implemented (see docs/mvp.md).
PAYMENT_PROVIDER=fake
NOTIFIER=console
PUBLIC_BASE_URL=http://127.0.0.1:8000
